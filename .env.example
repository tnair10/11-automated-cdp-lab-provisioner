# LocalStack license/auth token.
# Never commit the real token.
LOCALSTACK_AUTH_TOKEN=replace_me

# Local development backend
LAB_BACKEND=localstack

# LocalStack uses AWS-compatible dummy credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Real AWS backend safety settings.
# Keep actual account/principal values only in ignored .env.aws.

P11_AWS_PROFILE=p11-lab
P11_AWS_REGION=us-east-1
P11_EXPECTED_AWS_ACCOUNT_ID=replace_me
P11_EXPECTED_AWS_PRINCIPAL=replace_me
CONFIRM_AWS_COST=no
